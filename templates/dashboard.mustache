<div class="academic-timetabler-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-dark fw-bold">Dashboard & System Overview</h4>
        {{#is_enterprise}}
            <span class="badge bg-success text-white px-3 py-2 fs-6 rounded-pill shadow-sm">{{tier_name}}</span>
        {{/is_enterprise}}
        {{^is_enterprise}}
            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill shadow-sm">{{tier_name}}</span>
        {{/is_enterprise}}
    </div>

    <div id="license-notice-alert" class="alert fade show {{#is_enterprise}}alert-success border-success-subtle{{/is_enterprise}}{{^is_enterprise}}alert-info border-info-subtle{{/is_enterprise}} shadow-sm" role="alert">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>{{#str}}license_status, local_academic_timetabler{{/str}}:</strong> {{tier_notice}}
            </div>
            {{^is_enterprise}}
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{settings_url}}" class="btn btn-sm btn-primary">
                        Enter License Key
                    </a>
                    <a href="{{buy_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success">
                        {{#str}}buy_enterprise_license, local_academic_timetabler{{/str}} &rarr;
                    </a>
                    <button type="button" id="btn-continue-community" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('license-notice-alert').style.display='none';">
                        {{#str}}continue_community_edition, local_academic_timetabler{{/str}} &times;
                    </button>
                </div>
            {{/is_enterprise}}
        </div>
    </div>

    <div class="row g-3 my-3">
        <div class="col-md-4">
            <div class="card border-0 border-top border-4 border-primary shadow-sm h-100 bg-white">
                <div class="card-body p-4">
                    <div class="text-uppercase text-primary font-weight-bold fs-7 mb-1" style="letter-spacing: 0.5px;">Courses Target</div>
                    <div class="fs-2 font-weight-bold text-dark mb-1">{{course_count}} <span class="fs-6 text-muted font-weight-normal">/ {{max_courses_label}}</span></div>
                    <div class="text-muted small">Auto-synced active Moodle courses</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 border-top border-4 border-success shadow-sm h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-uppercase text-success font-weight-bold fs-7 mb-1" style="letter-spacing: 0.5px;">Configured Venues</div>
                        <div class="fs-2 font-weight-bold text-dark mb-1">{{room_count}} <span class="fs-6 text-muted font-weight-normal">Rooms</span></div>
                    </div>
                    <div class="mt-3">
                        <a href="{{rooms_url}}" class="btn btn-sm btn-outline-success font-weight-bold">Manage Rooms &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 border-top border-4 border-info shadow-sm h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-uppercase text-info font-weight-bold fs-7 mb-1" style="letter-spacing: 0.5px;">Generated Schedules</div>
                        <div class="fs-2 font-weight-bold text-dark mb-1">{{schedule_count}} <span class="fs-6 text-muted font-weight-normal">Entries</span></div>
                    </div>
                    <div class="mt-3">
                        <a href="{{schedules_url}}" class="btn btn-sm btn-outline-info font-weight-bold">View Timetables &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
