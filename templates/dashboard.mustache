<div class="academic-timetabler-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-dark fw-bold">Dashboard & System Overview</h4>
        {{#is_enterprise}}
            <span class="badge bg-success text-white px-3 py-2 fs-6 rounded-pill shadow-sm">{{tier_name}}</span>
        {{/is_enterprise}}
        {{^is_enterprise}}
            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill shadow-sm">{{tier_name}}</span>
        {{/is_enterprise}}
    </div>

    <div id="license-notice-alert" class="alert fade show {{#is_enterprise}}alert-success border-success-subtle{{/is_enterprise}}{{^is_enterprise}}alert-info border-info-subtle{{/is_enterprise}} shadow-sm" role="alert">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>{{#str}}license_status, local_academic_timetabler{{/str}}:</strong> {{tier_notice}}
            </div>
            {{^is_enterprise}}
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{settings_url}}" class="btn btn-sm btn-primary">
                        Enter License Key
                    </a>
                    <a href="{{buy_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success">
                        {{#str}}buy_enterprise_license, local_academic_timetabler{{/str}} &rarr;
                    </a>
                    <button type="button" id="btn-continue-community" class="btn btn-sm btn-outline-secondary" onclick="document.getElementById('license-notice-alert').style.display='none';">
                        {{#str}}continue_community_edition, local_academic_timetabler{{/str}} &times;
                    </button>
                </div>
            {{/is_enterprise}}
        </div>
    </div>

    <div class="row g-3 my-3">
        <div class="col-md-4">
            <div class="card border-0 border-top border-4 border-primary shadow-sm h-100 bg-white">
                <div class="card-body p-4">
                    <div class="text-uppercase text-primary font-weight-bold fs-7 mb-1" style="letter-spacing: 0.5px;">Courses Target</div>
                    <div class="fs-2 font-weight-bold text-dark mb-1">{{course_count}} <span class="fs-6 text-muted font-weight-normal">/ {{max_courses_label}}</span></div>
                    <div class="text-muted small">Auto-synced active Moodle courses</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 border-top border-4 border-success shadow-sm h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-uppercase text-success font-weight-bold fs-7 mb-1" style="letter-spacing: 0.5px;">Configured Venues</div>
                        <div class="fs-2 font-weight-bold text-dark mb-1">{{room_count}} <span class="fs-6 text-muted font-weight-normal">Rooms</span></div>
                    </div>
                    <div class="mt-3">
                        <a href="{{rooms_url}}" class="btn btn-sm btn-outline-success font-weight-bold">Manage Rooms &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 border-top border-4 border-info shadow-sm h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-uppercase text-info font-weight-bold fs-7 mb-1" style="letter-spacing: 0.5px;">Generated Schedules</div>
                        <div class="fs-2 font-weight-bold text-dark mb-1">{{schedule_count}} <span class="fs-6 text-muted font-weight-normal">Entries</span></div>
                    </div>
                    <div class="mt-3">
                        <a href="{{schedules_url}}" class="btn btn-sm btn-outline-info font-weight-bold">View Timetables &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Commercial Plans & Pricing Grid -->
    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="font-weight-bold text-dark mb-1">Commercial Licensing & Enterprise Tiers</h5>
                <p class="text-muted small mb-0">Choose the right capacity for your institution. All commercial plans include LemonSqueezy license keys and automated updates.</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            <!-- Tier 1: Starter / High School -->
            <div class="col">
                <div class="card h-100 att-pricing-card bg-white shadow-sm p-4 d-flex flex-column">
                    <div class="mb-3">
                        <span class="badge bg-light text-dark border font-weight-bold px-3 py-1 fs-7">High School / Department</span>
                        <h4 class="font-weight-bold text-dark mt-2 mb-1">Starter Edition</h4>
                        <div class="text-muted small">Ideal for small institutes & high schools</div>
                    </div>
                    <div class="my-3">
                        <span class="att-price-amount text-dark">$199</span>
                        <span class="text-muted">/ year</span>
                    </div>
                    <ul class="att-feature-list my-3 flex-grow-1">
                        <li><i class="fa fa-check-circle"></i> Up to 100 Active Courses</li>
                        <li><i class="fa fa-check-circle"></i> Up to 50 Campus Rooms</li>
                        <li><i class="fa fa-check-circle"></i> Master Course Timetable Solver</li>
                        <li><i class="fa fa-check-circle"></i> Institutional Schedule Profiles</li>
                        <li><i class="fa fa-check-circle"></i> Standard Email Support</li>
                    </ul>
                    <div class="pt-3 border-top mt-auto">
                        <a href="{{buy_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-block font-weight-bold w-100 py-2">
                            Get Starter Plan &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tier 2: Pro / University (Popular) -->
            <div class="col">
                <div class="card h-100 att-pricing-card att-pricing-popular bg-white shadow-sm p-4 d-flex flex-column position-relative">
                    <div class="position-absolute top-0 end-0 translate-middle-y me-3">
                        <span class="badge bg-primary text-white font-weight-bold px-3 py-2 shadow-sm rounded-pill">MOST POPULAR</span>
                    </div>
                    <div class="mb-3">
                        <span class="badge bg-primary-subtle text-primary font-weight-bold px-3 py-1 fs-7">University / College</span>
                        <h4 class="font-weight-bold text-dark mt-2 mb-1">Pro University</h4>
                        <div class="text-muted small">Complete scheduling for higher education</div>
                    </div>
                    <div class="my-3">
                        <span class="att-price-amount text-primary">$499</span>
                        <span class="text-muted">/ year</span>
                    </div>
                    <ul class="att-feature-list my-3 flex-grow-1">
                        <li><i class="fa fa-check-circle"></i> <strong>UNLIMITED</strong> Active Courses</li>
                        <li><i class="fa fa-check-circle"></i> <strong>UNLIMITED</strong> Campus Rooms & Venues</li>
                        <li><i class="fa fa-check-circle"></i> Combined Course & Exam Timetable Solver</li>
                        <li><i class="fa fa-check-circle"></i> Background Adhoc Task Solver</li>
                        <li><i class="fa fa-check-circle"></i> Custom Break Windows & Rules</li>
                        <li><i class="fa fa-check-circle"></i> Priority Ticket Support</li>
                    </ul>
                    <div class="pt-3 border-top mt-auto">
                        <a href="{{buy_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block font-weight-bold w-100 py-2 shadow-sm">
                            Get Pro University &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tier 3: Enterprise Multi-Site -->
            <div class="col">
                <div class="card h-100 att-pricing-card bg-white shadow-sm p-4 d-flex flex-column">
                    <div class="mb-3">
                        <span class="badge bg-dark text-white font-weight-bold px-3 py-1 fs-7">Multi-Site System</span>
                        <h4 class="font-weight-bold text-dark mt-2 mb-1">Enterprise System</h4>
                        <div class="text-muted small">For multi-campus university networks</div>
                    </div>
                    <div class="my-3">
                        <span class="att-price-amount text-dark">$1,499</span>
                        <span class="text-muted">/ year</span>
                    </div>
                    <ul class="att-feature-list my-3 flex-grow-1">
                        <li><i class="fa fa-check-circle"></i> <strong>Multi-Site / Multi-Moodle</strong> Deployment</li>
                        <li><i class="fa fa-check-circle"></i> Custom Solver Constraint Engineering</li>
                        <li><i class="fa fa-check-circle"></i> Dedicated Technical Onboarding SLA</li>
                        <li><i class="fa fa-check-circle"></i> Direct SIS/ERP Integration Support</li>
                        <li><i class="fa fa-check-circle"></i> 1-on-1 Admin Training Session</li>
                    </ul>
                    <div class="pt-3 border-top mt-auto">
                        <a href="{{buy_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-block font-weight-bold w-100 py-2">
                            Contact Enterprise &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
